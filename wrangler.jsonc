{
  "name": "haru-alarm",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "HARU",
      "id": "01d2d35a8bef4831a15063c67516638d"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "HARU_SYNC_DB",
      "database_name": "haru-sync",
      "database_id": "363322a7-fc00-4d48-b141-c88c6fb82ddb"
    }
  ]
}